# Copy to .env (gitignored). One KEY=value per line; full-line comments only.

# Fine-grained GitHub token. Agents watch every repo it can push to.
# Permissions: Contents, Issues, Pull requests (read/write). Leave Workflows off.
GH_DEMO_TOKEN=github_pat_...

# Claude credential: one of the two. Leave both unset and run.py runs `claude setup-token` for you.
# CLAUDE_CODE_OAUTH_TOKEN=...   # from `claude setup-token`; runs on your Claude Pro/Max subscription
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Model for the agent; defaults to sonnet.
# AGENT_MODEL=sonnet

# Modal: run `.venv/bin/modal setup` instead, or set these.
# MODAL_TOKEN_ID=...
# MODAL_TOKEN_SECRET=...
